# =============================================================================
# Binance AI Hedge Fund OS — Environment Template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Application ---
APP_NAME=binance-ai-hedge-fund-os
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Binance API ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true           # Use the Binance testnet by default (paper-safe)

# --- Trading Mode ---
TRADING_MODE=paper             # paper | live  (keep on `paper` until authorized)

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hedge_fund_os

# --- Cache / Message Broker ---
REDIS_URL=redis://localhost:6379/0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9090
